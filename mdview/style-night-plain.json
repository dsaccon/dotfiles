{
 "document": {
  "block_prefix": "\n",
  "block_suffix": "\n",
  "color": "#a9b1d6",
  "margin": 2
 },
 "block_quote": {
  "indent": 1,
  "indent_token": "│ ",
  "color": "#7aa2f7",
  "italic": true
 },
 "paragraph": {},
 "list": {
  "color": "#a9b1d6",
  "level_indent": 2
 },
 "heading": {
  "block_suffix": "\n",
  "color": "#bb9af7",
  "bold": true
 },
 "h1": {
  "color": "#1a1b26",
  "bold": true,
  "block_prefix": "\n",
  "background_color": "#7aa2f7",
  "prefix": "  #  ",
  "suffix": "  ",
  "block_suffix": "\n"
 },
 "h2": {
  "color": "#bb9af7",
  "bold": true,
  "block_prefix": "\n",
  "prefix": "▌ "
 },
 "h3": {
  "color": "#7dcfff",
  "bold": true,
  "block_prefix": "\n",
  "prefix": " ▸ "
 },
 "h4": {
  "color": "#9ece6a",
  "bold": true,
  "block_prefix": "\n",
  "prefix": "  ● "
 },
 "h5": {
  "color": "#b4f9f8",
  "bold": false,
  "block_prefix": "\n",
  "prefix": "   ○ "
 },
 "h6": {
  "color": "#565f89",
  "bold": false,
  "block_prefix": "\n",
  "prefix": "    – "
 },
 "text": {},
 "strikethrough": {
  "crossed_out": true
 },
 "emph": {
  "italic": true,
  "color": "#7dcfff"
 },
 "strong": {
  "bold": true,
  "color": "#bb9af7"
 },
 "hr": {
  "color": "#565f89",
  "format": "\n--------\n"
 },
 "item": {
  "block_prefix": "• "
 },
 "enumeration": {
  "block_prefix": ". ",
  "color": "#7aa2f7"
 },
 "task": {
  "ticked": "[✓] ",
  "unticked": "[ ] "
 },
 "link": {
  "color": "#7aa2f7",
  "underline": true
 },
 "link_text": {
  "color": "#2ac3de"
 },
 "image": {
  "color": "#7aa2f7",
  "underline": true
 },
 "image_text": {
  "color": "#2ac3de",
  "format": "Image: {{.text}} →"
 },
 "code": {
  "color": "#9ece6a"
 },
 "code_block": {
  "color": "#bb9af7",
  "margin": 2,
  "chroma": {
   "text": {
    "color": "#a9b1d6"
   },
   "error": {
    "color": "#a9b1d6",
    "background_color": "#f7768e"
   },
   "comment": {
    "color": "#565f89"
   },
   "comment_preproc": {
    "color": "#2ac3de"
   },
   "keyword": {
    "color": "#2ac3de"
   },
   "keyword_reserved": {
    "color": "#2ac3de"
   },
   "keyword_namespace": {
    "color": "#2ac3de"
   },
   "keyword_type": {
    "color": "#7aa2f7"
   },
   "operator": {
    "color": "#2ac3de"
   },
   "punctuation": {
    "color": "#a9b1d6"
   },
   "name": {
    "color": "#7aa2f7"
   },
   "name_builtin": {
    "color": "#7aa2f7"
   },
   "name_tag": {
    "color": "#2ac3de"
   },
   "name_attribute": {
    "color": "#9ece6a"
   },
   "name_class": {
    "color": "#7aa2f7"
   },
   "name_constant": {
    "color": "#bb9af7"
   },
   "name_decorator": {
    "color": "#9ece6a"
   },
   "name_exception": {},
   "name_function": {
    "color": "#9ece6a"
   },
   "name_other": {},
   "literal": {},
   "literal_number": {},
   "literal_date": {},
   "literal_string": {
    "color": "#e0af68"
   },
   "literal_string_escape": {
    "color": "#2ac3de"
   },
   "generic_deleted": {
    "color": "#f7768e"
   },
   "generic_emph": {
    "italic": true
   },
   "generic_inserted": {
    "color": "#9ece6a"
   },
   "generic_strong": {
    "bold": true
   },
   "generic_subheading": {
    "color": "#bb9af7"
   },
   "background": {
    "background_color": "#1a1b26"
   }
  }
 },
 "table": {},
 "definition_list": {},
 "definition_term": {},
 "definition_description": {
  "block_prefix": "\n🠶 "
 },
 "html_block": {},
 "html_span": {}
}
